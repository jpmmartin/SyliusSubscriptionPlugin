# Behat runner configuration. Suites live in tests/Behat/Resources/suites.yml; the first
# import pulls in every suite Sylius itself ships, so any core feature can be run against
# the test application with this plugin registered.
imports:
    - vendor/sylius/sylius/src/Sylius/Behat/Resources/config/suites.yml
    - tests/Behat/Resources/suites.yml

default:
    # Same value as Sylius's own behat.yml.dist. Behat turns every reported error raised during a
    # step into an exception, and the kernel handles requests in-process inside the step, so a
    # deprecation triggered by vendor code (Payum on league/uri 7, for one) would become a 500.
    calls:
        error_reporting: 8191 # E_ALL & ~E_DEPRECATED & ~E_USER_DEPRECATED

    formatters:
        pretty:
            verbose: true
            paths: false
            snippets: false

    extensions:
        DMore\ChromeExtension\Behat\ServiceContainer\ChromeExtension: ~

        FriendsOfBehat\MinkDebugExtension:
            directory: etc/build
            clean_start: false
            screenshot: true

        Behat\MinkExtension:
            files_path: "%paths.base%/vendor/sylius/sylius/src/Sylius/Behat/Resources/fixtures/"
            # Resolved from tests/TestApplication/.env by the test application's bootstrap.
            base_url: "%env(BEHAT_BASE_URL)%"
            default_session: symfony
            javascript_session: chrome
            sessions:
                symfony:
                    symfony: ~
                chrome:
                    chrome:
                        api_url: http://127.0.0.1:9222
                        validate_certificate: false
            show_auto: false

        FriendsOfBehat\SymfonyExtension:
            bootstrap: vendor/sylius/test-application/config/bootstrap.php
            kernel:
                class: Sylius\TestApplication\Kernel
                environment: test

        FriendsOfBehat\VariadicExtension: ~

        FriendsOfBehat\SuiteSettingsExtension:
            paths:
                - "features"

        SyliusLabs\SuiteTagsExtension: ~
