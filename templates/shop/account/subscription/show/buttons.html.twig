{% set subscription = hookable_metadata.context.subscription %}

{% if jpm_martin_sylius_subscription_can_recover(subscription) %}
    <div class="alert alert-warning d-flex flex-wrap align-items-center gap-2" {{ sylius_test_html_attribute('recovery') }}>
        <span>{{ 'jpm_martin_sylius_subscription.ui.recovery_help'|trans }}</span>
        <a class="btn btn-primary" href="{{ path('jpm_martin_sylius_subscription_shop_account_subscription_recover', { id: subscription.id }) }}" {{ sylius_test_html_attribute('pay-and-reactivate') }}>
            {{ 'jpm_martin_sylius_subscription.ui.pay_and_reactivate'|trans }}
        </a>
    </div>
{% else %}
    {% set why_not_recoverable = jpm_martin_sylius_subscription_why_not_recoverable(subscription) %}
    {% if why_not_recoverable is not null %}
        <div class="alert alert-secondary" {{ sylius_test_html_attribute('not-recoverable') }}>
            {{ ('jpm_martin_sylius_subscription.ui.not_recoverable.' ~ why_not_recoverable)|trans }}
        </div>
    {% endif %}
{% endif %}

<div class="d-flex flex-wrap gap-2 mb-3">
    {% if jpm_martin_sylius_subscription_frequencies_to_change_to(subscription) is not empty %}
        <a class="btn btn-outline-primary" href="{{ path('jpm_martin_sylius_subscription_shop_account_subscription_change_frequency', { id: subscription.id }) }}" {{ sylius_test_html_attribute('change-frequency') }}>
            {{ 'jpm_martin_sylius_subscription.ui.change_frequency'|trans }}
        </a>
    {% endif %}
    {% if jpm_martin_sylius_subscription_can_change_address(subscription) %}
        <a class="btn btn-outline-primary" href="{{ path('jpm_martin_sylius_subscription_shop_account_subscription_change_address', { id: subscription.id }) }}" {{ sylius_test_html_attribute('change-address') }}>
            {{ 'jpm_martin_sylius_subscription.ui.change_address'|trans }}
        </a>
    {% endif %}
    {% if jpm_martin_sylius_subscription_can_change_items(subscription) %}
        <a class="btn btn-outline-primary" href="{{ path('jpm_martin_sylius_subscription_shop_account_subscription_change_items', { id: subscription.id }) }}" {{ sylius_test_html_attribute('change-items') }}>
            {{ 'jpm_martin_sylius_subscription.ui.change_items'|trans }}
        </a>
    {% endif %}
    {% if jpm_martin_sylius_subscription_can_add_items(subscription) %}
        <a class="btn btn-outline-primary" href="{{ path('jpm_martin_sylius_subscription_shop_account_subscription_add_item', { id: subscription.id }) }}" {{ sylius_test_html_attribute('add-product') }}>
            {{ 'jpm_martin_sylius_subscription.ui.add_product'|trans }}
        </a>
    {% endif %}
    {% set card_update_url = jpm_martin_sylius_subscription_card_update_url(subscription) %}
    {% if card_update_url is not null %}
        <a class="btn btn-outline-primary" href="{{ card_update_url }}" {{ sylius_test_html_attribute('change-card') }}>
            {{ 'jpm_martin_sylius_subscription.ui.change_card'|trans }}
        </a>
    {% endif %}
    {% set renewal_to_skip = jpm_martin_sylius_subscription_renewal_to_skip(subscription) %}
    {% if renewal_to_skip is not null %}
        <form method="post" action="{{ path('jpm_martin_sylius_subscription_shop_account_subscription_skip_renewal', { id: subscription.id }) }}">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('jpm_martin_sylius_subscription_skip_renewal_' ~ subscription.id) }}">
            <button type="submit" class="btn btn-outline-primary" {{ sylius_test_html_attribute('skip-renewal') }}>
                {{ 'jpm_martin_sylius_subscription.ui.skip_renewal'|trans({ '%date%': renewal_to_skip.scheduledAt|format_date }) }}
            </button>
        </form>
    {% endif %}
    {% for transition in ['pause', 'resume'] %}
        {% if sylius_sm_can(subscription, 'jpm_martin_sylius_subscription', transition) %}
            <form method="post" action="{{ path('jpm_martin_sylius_subscription_shop_account_subscription_' ~ transition, { id: subscription.id }) }}">
                <input type="hidden" name="_method" value="PUT">
                <input type="hidden" name="_csrf_token" value="{{ csrf_token(subscription.id) }}">
                <button type="submit" class="btn btn-outline-primary" {{ sylius_test_html_attribute(transition) }}>
                    {{ ('jpm_martin_sylius_subscription.ui.' ~ transition)|trans }}
                </button>
            </form>
        {% endif %}
    {% endfor %}
    {% if sylius_sm_can(subscription, 'jpm_martin_sylius_subscription', 'cancel') %}
        <form method="post" action="{{ path('jpm_martin_sylius_subscription_shop_account_subscription_cancel', { id: subscription.id }) }}">
            <input type="hidden" name="_method" value="PUT">
            <input type="hidden" name="_csrf_token" value="{{ csrf_token(subscription.id) }}">
            <button type="submit" class="btn btn-outline-danger" {{ sylius_test_html_attribute('cancel') }}>
                {{ 'jpm_martin_sylius_subscription.ui.cancel_subscription'|trans }}
            </button>
        </form>
    {% endif %}
</div>
