{% import '@JpmMartinSyliusSubscriptionPlugin/shared/macro/charge.html.twig' as charge %}
{% from '@SyliusShop/shared/macro/money.html.twig' import format %}
{% from '@JpmMartinSyliusSubscriptionPlugin/shop/account/subscription/macro/state.html.twig' import label %}
{% from '@JpmMartinSyliusSubscriptionPlugin/shared/macro/frequency.html.twig' import frequency %}
{% from '@JpmMartinSyliusSubscriptionPlugin/shared/macro/address.html.twig' import one_line %}

{% set subscription = hookable_metadata.context.subscription %}
{% set open_cycle = jpm_martin_sylius_subscription_open_cycle(subscription) %}
{% set remaining_commitment = jpm_martin_sylius_subscription_remaining_commitment(subscription) %}
{% set last_prepaid_delivery = jpm_martin_sylius_subscription_last_prepaid_delivery(subscription) %}

<div class="mb-4">
    <div class="row mb-1">
        <div class="col-12 col-sm-4">{{ 'sylius.ui.state'|trans }}</div>
        <div class="col" {{ sylius_test_html_attribute('subscription-state') }}>{{ label(subscription.state) }}</div>
    </div>
    <div class="row mb-1">
        <div class="col-12 col-sm-4">{{ 'jpm_martin_sylius_subscription.ui.frequency'|trans }}</div>
        <div class="col" {{ sylius_test_html_attribute('subscription-frequency') }}>{{ frequency(subscription) }}</div>
    </div>
    <div class="row mb-1">
        <div class="col-12 col-sm-4">{{ charge.label(subscription) }}</div>
        <div class="col" {{ sylius_test_html_attribute('subscription-price') }}>{{ charge.amount(subscription, format(subscription.renewalTotal * subscription.deliveriesPerCharge, subscription.currencyCode)) }}</div>
    </div>
    {% if last_prepaid_delivery is not null %}
        <div class="row mb-1">
            <div class="col-12 col-sm-4">{{ 'jpm_martin_sylius_subscription.ui.prepaid_deliveries'|trans }}</div>
            <div class="col" {{ sylius_test_html_attribute('subscription-prepaid-deliveries') }}>
                {% if subscription.cancelsAfterPrepaidDeliveries %}
                    {{ 'jpm_martin_sylius_subscription.ui.cancelled_after_prepaid_deliveries'|trans({ '%date%': last_prepaid_delivery|format_date }) }}
                {% else %}
                    {{ 'jpm_martin_sylius_subscription.ui.prepaid_deliveries_left'|trans({ '%count%': subscription.prepaidDeliveriesLeft, '%date%': last_prepaid_delivery|format_date }) }}
                {% endif %}
            </div>
        </div>
    {% endif %}
    {% if remaining_commitment > 0 %}
        <div class="row mb-1">
            <div class="col-12 col-sm-4">{{ 'jpm_martin_sylius_subscription.ui.minimum_commitment'|trans }}</div>
            <div class="col" {{ sylius_test_html_attribute('subscription-commitment') }}>{{ 'jpm_martin_sylius_subscription.ui.commitment_left'|trans({ '%count%': remaining_commitment }) }}</div>
        </div>
    {% endif %}
    <div class="row mb-1">
        <div class="col-12 col-sm-4">{{ 'jpm_martin_sylius_subscription.ui.next_renewal'|trans }}</div>
        <div class="col" {{ sylius_test_html_attribute('subscription-next-renewal') }}>{{ open_cycle is not null ? open_cycle.scheduledAt|format_date : '—' }}</div>
    </div>
    <div class="row mb-1">
        <div class="col-12 col-sm-4">{{ 'sylius.ui.shipping_address'|trans }}</div>
        <div class="col" {{ sylius_test_html_attribute('subscription-shipping-address') }}>{{ one_line(jpm_martin_sylius_subscription_renewal_shipping_address(subscription)) }}</div>
    </div>
    <div class="row mb-1">
        <div class="col-12 col-sm-4">{{ 'sylius.ui.billing_address'|trans }}</div>
        <div class="col" {{ sylius_test_html_attribute('subscription-billing-address') }}>{{ one_line(jpm_martin_sylius_subscription_renewal_billing_address(subscription)) }}</div>
    </div>
</div>
