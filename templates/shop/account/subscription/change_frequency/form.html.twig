{% set subscription = hookable_metadata.context.subscription %}
{% set form = hookable_metadata.context.form %}

{{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
    {{ form_row(form.frequency, sylius_test_form_attribute('frequency')) }}
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary" {{ sylius_test_html_attribute('confirm-frequency-change') }}>{{ 'jpm_martin_sylius_subscription.ui.change_frequency'|trans }}</button>
        <a class="btn btn-outline-gray" href="{{ path('jpm_martin_sylius_subscription_shop_account_subscription_show', { id: subscription.id }) }}">{{ 'sylius.ui.cancel'|trans }}</a>
    </div>
{{ form_end(form) }}
