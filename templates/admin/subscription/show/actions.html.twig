{% set subscription = hookable_metadata.context.resource %}

<div class="col-12 col-md-auto ms-auto d-print-none">
    <div class="btn-list">
        {% if jpm_martin_sylius_subscription_frequencies_to_change_to(subscription) is not empty %}
            <a class="btn" href="{{ path('jpm_martin_sylius_subscription_admin_subscription_change_frequency', { id: subscription.id }) }}" {{ sylius_test_html_attribute('change-frequency') }}>
                {{ 'jpm_martin_sylius_subscription.ui.change_frequency'|trans }}
            </a>
        {% endif %}
        {% for transition in ['suspend', 'reactivate', 'cancel'] %}
            {% if sylius_sm_can(subscription, 'jpm_martin_sylius_subscription', transition) %}
                <form method="post" action="{{ path('jpm_martin_sylius_subscription_admin_subscription_' ~ transition, { id: subscription.id }) }}" class="d-inline">
                    <input type="hidden" name="_method" value="PUT">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token(subscription.id) }}">
                    <button type="submit" class="btn {{ transition == 'cancel' ? 'btn-outline-danger' : '' }}" {{ sylius_test_html_attribute(transition) }}>
                        {{ ('jpm_martin_sylius_subscription.ui.' ~ transition)|trans }}
                    </button>
                </form>
            {% endif %}
        {% endfor %}
    </div>
</div>
