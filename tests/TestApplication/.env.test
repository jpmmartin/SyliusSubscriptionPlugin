DATABASE_URL=mysql://root:root@127.0.0.1/jpmmartin_sylius_subscription_plugin_%kernel.environment%

# Renewals are charged synchronously in the tests, so an outcome is known as soon as the charge returns.
# That is also Sylius's own default; the test application queues payment requests for a worker instead.
SYLIUS_MESSENGER_TRANSPORT_PAYMENT_REQUEST_DSN=sync://

# Payment requests are encrypted as in any Sylius 2 store, with a key kept for the tests only.
SYLIUS_PAYMENT_ENCRYPTION_KEY_PATH=%kernel.project_dir%/../../../tests/TestApplication/config/encryption/test.key
