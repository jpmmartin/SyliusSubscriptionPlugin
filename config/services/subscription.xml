<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <!-- The resource's own factory, taught to start a subscription from lines of a placed order. -->
        <service id="jpm_martin_sylius_subscription.factory.subscription.from_order_item"
                 class="JpmMartin\SyliusSubscriptionPlugin\Factory\SubscriptionFactory"
                 decorates="jpm_martin_sylius_subscription.factory.subscription"
        >
            <argument type="service" id=".inner" />
            <argument type="service" id="jpm_martin_sylius_subscription.factory.subscription_item" />
            <argument type="service" id="jpm_martin_sylius_subscription.consent.recorder" />
        </service>

        <service id="jpm_martin_sylius_subscription.schedule.calendar" class="JpmMartin\SyliusSubscriptionPlugin\Schedule\SubscriptionCalendar" />
        <service id="JpmMartin\SyliusSubscriptionPlugin\Schedule\SubscriptionCalendarInterface" alias="jpm_martin_sylius_subscription.schedule.calendar" />

        <!-- After Sylius's own listeners on the same event, which run at 400 to 100. -->
        <service id="jpm_martin_sylius_subscription.listener.workflow.order_checkout.create_subscriptions"
                 class="JpmMartin\SyliusSubscriptionPlugin\EventListener\Workflow\OrderCheckout\CreateSubscriptionsListener"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.factory.subscription" />
            <argument type="service" id="jpm_martin_sylius_subscription.manager.subscription" />
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription_cycle" />
            <tag name="kernel.event_listener" event="workflow.sylius_order_checkout.completed.complete" priority="0" />
        </service>

        <service id="JpmMartin\SyliusSubscriptionPlugin\Repository\SubscriptionRepositoryInterface" alias="jpm_martin_sylius_subscription.repository.subscription" />

        <service id="jpm_martin_sylius_subscription.schedule.scheduler" class="JpmMartin\SyliusSubscriptionPlugin\Schedule\SubscriptionScheduler">
            <argument type="service" id="jpm_martin_sylius_subscription.factory.subscription_cycle" />
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.calendar" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <argument type="service" id="JpmMartin\SyliusSubscriptionPlugin\Schedule\MissedCyclePolicyInterface" />
            <argument type="service" id="clock" />
            <argument type="service" id="logger" on-invalid="ignore" />
        </service>
        <service id="JpmMartin\SyliusSubscriptionPlugin\Schedule\SubscriptionSchedulerInterface" alias="jpm_martin_sylius_subscription.schedule.scheduler" />

        <!-- Replace this service, or point the interface alias elsewhere, to deal with the dates that passed another way. -->
        <service id="jpm_martin_sylius_subscription.schedule.missed_cycle_policy" class="JpmMartin\SyliusSubscriptionPlugin\Schedule\ConfigurableMissedCyclePolicy">
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.calendar" />
            <argument>%jpm_martin_sylius_subscription.missed_cycles%</argument>
        </service>
        <service id="JpmMartin\SyliusSubscriptionPlugin\Schedule\MissedCyclePolicyInterface" alias="jpm_martin_sylius_subscription.schedule.missed_cycle_policy" />

        <!-- The subscription graph's own side effects, whichever code applies the transition. -->
        <service id="jpm_martin_sylius_subscription.listener.workflow.subscription.start_schedule"
                 class="JpmMartin\SyliusSubscriptionPlugin\EventListener\Workflow\Subscription\StartScheduleListener"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.factory.subscription_cycle" />
            <argument type="service" id="jpm_martin_sylius_subscription.factory.subscription_cycle_item" />
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.scheduler" />
            <argument type="service" id="clock" />
            <tag name="kernel.event_listener" event="workflow.jpm_martin_sylius_subscription.completed.activate" />
        </service>

        <service id="jpm_martin_sylius_subscription.listener.workflow.subscription.cancel_open_cycle"
                 class="JpmMartin\SyliusSubscriptionPlugin\EventListener\Workflow\Subscription\CancelOpenCycleListener"
        >
            <argument type="service" id="sylius_abstraction.state_machine" />
            <tag name="kernel.event_listener" event="workflow.jpm_martin_sylius_subscription.completed.cancel" />
            <tag name="kernel.event_listener" event="workflow.jpm_martin_sylius_subscription.completed.suspend" />
        </service>

        <service id="jpm_martin_sylius_subscription.listener.workflow.subscription.resume_schedule"
                 class="JpmMartin\SyliusSubscriptionPlugin\EventListener\Workflow\Subscription\ResumeScheduleListener"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.calendar" />
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.scheduler" />
            <argument type="service" id="clock" />
            <tag name="kernel.event_listener" event="workflow.jpm_martin_sylius_subscription.completed.reactivate" />
        </service>

        <!-- The initial order drives its subscriptions. -->
        <service id="jpm_martin_sylius_subscription.listener.workflow.order.activate_subscriptions"
                 class="JpmMartin\SyliusSubscriptionPlugin\EventListener\Workflow\Order\ActivateSubscriptionsListener"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <tag name="kernel.event_listener" event="workflow.sylius_order_payment.completed.pay" />
        </service>

        <service id="jpm_martin_sylius_subscription.listener.workflow.order.cancel_subscriptions"
                 class="JpmMartin\SyliusSubscriptionPlugin\EventListener\Workflow\Order\CancelSubscriptionsListener"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription" />
            <argument type="service" id="sylius_abstraction.state_machine" />
            <tag name="kernel.event_listener" event="workflow.sylius_order.completed.cancel" />
        </service>

        <service id="jpm_martin_sylius_subscription.query.committed_cycles" class="JpmMartin\SyliusSubscriptionPlugin\Query\CommittedCyclesQuery">
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription" />
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.scheduler" />
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.calendar" />
            <argument type="service" id="clock" />
            <argument type="service" id="JpmMartin\SyliusSubscriptionPlugin\Schedule\MissedCyclePolicyInterface" />
        </service>
        <service id="JpmMartin\SyliusSubscriptionPlugin\Query\CommittedCyclesQueryInterface" alias="jpm_martin_sylius_subscription.query.committed_cycles" public="true" />
    </services>
</container>
