<?xml version="1.0" encoding="UTF-8" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd"
>
    <services>
        <service id="jpm_martin_sylius_subscription.management.terms_finder" class="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionTermsFinder">
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription_plan" />
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription_frequency" />
        </service>

        <service id="jpm_martin_sylius_subscription.management.frequency_changer" class="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionFrequencyChanger">
            <argument type="service" id="jpm_martin_sylius_subscription.management.terms_finder" />
            <argument type="service" id="sylius.calculator.product_variant_price" />
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.scheduler" />
            <argument type="service" id="jpm_martin_sylius_subscription.event.publisher" />
        </service>
        <service id="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionFrequencyChangerInterface" alias="jpm_martin_sylius_subscription.management.frequency_changer" public="true" />

        <service id="jpm_martin_sylius_subscription.management.cycle_retrier" class="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionCycleRetrier">
            <argument type="service" id="sylius_abstraction.state_machine" />
            <argument type="service" id="jpm_martin_sylius_subscription.order.renewal_placer" />
            <argument type="service" id="jpm_martin_sylius_subscription.cycle.charger" />
            <argument type="service" id="jpm_martin_sylius_subscription.cycle.failure_handler" />
        </service>
        <service id="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionCycleRetrierInterface" alias="jpm_martin_sylius_subscription.management.cycle_retrier" public="true" />

        <!-- Replace this service, or point the interface alias elsewhere, to let customers skip another way. -->
        <service id="jpm_martin_sylius_subscription.management.renewal_skipper" class="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionRenewalSkipper">
            <argument type="service" id="sylius_abstraction.state_machine" />
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.scheduler" />
            <argument type="service" id="jpm_martin_sylius_subscription.event.publisher" />
            <argument>%jpm_martin_sylius_subscription.max_consecutive_skips%</argument>
        </service>
        <service id="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionRenewalSkipperInterface" alias="jpm_martin_sylius_subscription.management.renewal_skipper" public="true" />

        <!-- Replace this service, or point the interface alias elsewhere, to change addresses another way. -->
        <service id="jpm_martin_sylius_subscription.management.address_changer" class="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionAddressChanger">
            <argument type="service" id="sylius.factory.order" />
            <argument type="service" id="sylius.factory.order_item" />
            <argument type="service" id="sylius.modifier.order_item_quantity" />
            <argument type="service" id="sylius.factory.shipment" />
            <argument type="service" id="sylius.resolver.shipping_methods" />
            <argument type="service" id="sylius.calculator.shipping" />
            <argument type="service" id="jpm_martin_sylius_subscription.order.address_copier" />
            <argument type="service" id="jpm_martin_sylius_subscription.event.publisher" />
        </service>
        <service id="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionAddressChangerInterface" alias="jpm_martin_sylius_subscription.management.address_changer" public="true" />

        <!-- Replace this service, or point the interface alias elsewhere, to let customers change their items another way. -->
        <service id="jpm_martin_sylius_subscription.management.item_editor" class="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionItemEditor">
            <argument type="service" id="jpm_martin_sylius_subscription.management.terms_finder" />
            <argument type="service" id="jpm_martin_sylius_subscription.frequency.repeatable_variants" />
            <argument type="service" id="jpm_martin_sylius_subscription.order.variant_availability_checker" />
            <argument type="service" id="sylius.calculator.product_variant_price" />
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.scheduler" />
            <argument type="service" id="jpm_martin_sylius_subscription.consent.recorder" />
            <argument type="service" id="jpm_martin_sylius_subscription.factory.subscription_item" />
            <argument type="service" id="clock" />
            <argument type="service" id="jpm_martin_sylius_subscription.event.publisher" />
            <argument>%sylius.order_item_quantity_modifier.limit%</argument>
        </service>
        <service id="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionItemEditorInterface" alias="jpm_martin_sylius_subscription.management.item_editor" public="true" />

        <!-- Replace this service, or point the interface alias elsewhere, to let customers recover another way. -->
        <service id="jpm_martin_sylius_subscription.management.recovery" class="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionRecovery">
            <argument type="service" id="sylius_abstraction.state_machine" />
            <argument type="service" id="jpm_martin_sylius_subscription.order.renewal_placer" />
            <argument type="service" id="jpm_martin_sylius_subscription.order.variant_availability_checker" />
        </service>
        <service id="JpmMartin\SyliusSubscriptionPlugin\Management\SubscriptionRecoveryInterface" alias="jpm_martin_sylius_subscription.management.recovery" public="true" />

        <service id="jpm_martin_sylius_subscription.controller.recover_subscription"
                 class="JpmMartin\SyliusSubscriptionPlugin\Controller\RecoverSubscriptionAction"
                 public="true"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription" />
            <argument type="service" id="sylius.context.customer" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.recovery" />
            <argument type="service" id="jpm_martin_sylius_subscription.manager.subscription" />
            <argument type="service" id="router" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="jpm_martin_sylius_subscription.form.type.subscription_items_change" class="JpmMartin\SyliusSubscriptionPlugin\Form\Type\SubscriptionItemsChangeType">
            <tag name="form.type" />
        </service>

        <service id="jpm_martin_sylius_subscription.form.type.subscription_item_edit" class="JpmMartin\SyliusSubscriptionPlugin\Form\Type\SubscriptionItemEditType">
            <argument type="service" id="jpm_martin_sylius_subscription.management.item_editor" />
            <argument type="service" id="sylius.formatter.money" />
            <argument type="service" id="sylius.context.locale" />
            <tag name="form.type" />
        </service>

        <service id="jpm_martin_sylius_subscription.form.type.subscription_item_addition" class="JpmMartin\SyliusSubscriptionPlugin\Form\Type\SubscriptionItemAdditionType">
            <argument type="service" id="jpm_martin_sylius_subscription.management.item_editor" />
            <argument type="service" id="sylius.formatter.money" />
            <argument type="service" id="sylius.context.locale" />
            <tag name="form.type" />
        </service>

        <service id="jpm_martin_sylius_subscription.controller.change_subscription_items"
                 class="JpmMartin\SyliusSubscriptionPlugin\Controller\ChangeSubscriptionItemsAction"
                 public="true"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription" />
            <argument type="service" id="sylius.context.customer" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.item_editor" />
            <argument type="service" id="form.factory" />
            <argument type="service" id="jpm_martin_sylius_subscription.manager.subscription" />
            <argument type="service" id="twig" />
            <argument type="service" id="router" />
            <argument type="service" id="translator" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="jpm_martin_sylius_subscription.controller.add_subscription_item"
                 class="JpmMartin\SyliusSubscriptionPlugin\Controller\AddSubscriptionItemAction"
                 public="true"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription" />
            <argument type="service" id="sylius.context.customer" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.item_editor" />
            <argument type="service" id="form.factory" />
            <argument type="service" id="jpm_martin_sylius_subscription.manager.subscription" />
            <argument type="service" id="twig" />
            <argument type="service" id="router" />
            <argument type="service" id="translator" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="jpm_martin_sylius_subscription.form.type.subscription_address_change" class="JpmMartin\SyliusSubscriptionPlugin\Form\Type\SubscriptionAddressChangeType">
            <tag name="form.type" />
        </service>

        <service id="jpm_martin_sylius_subscription.controller.change_subscription_address"
                 class="JpmMartin\SyliusSubscriptionPlugin\Controller\ChangeSubscriptionAddressAction"
                 public="true"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription" />
            <argument type="service" id="sylius.context.customer" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.address_changer" />
            <argument type="service" id="form.factory" />
            <argument type="service" id="jpm_martin_sylius_subscription.manager.subscription" />
            <argument type="service" id="twig" />
            <argument type="service" id="router" />
            <argument type="service" id="translator" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="jpm_martin_sylius_subscription.command_handler.skip_subscription_renewal"
                 class="JpmMartin\SyliusSubscriptionPlugin\CommandHandler\SkipSubscriptionRenewalHandler"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.renewal_skipper" />
            <tag name="messenger.message_handler" bus="sylius.command_bus" />
        </service>

        <service id="jpm_martin_sylius_subscription.controller.skip_subscription_renewal"
                 class="JpmMartin\SyliusSubscriptionPlugin\Controller\SkipSubscriptionRenewalAction"
                 public="true"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription" />
            <argument type="service" id="sylius.context.customer" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.renewal_skipper" />
            <argument type="service" id="sylius.command_bus" />
            <argument type="service" id="security.csrf.token_manager" />
            <argument type="service" id="router" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="jpm_martin_sylius_subscription.form.type.subscription_frequency_change" class="JpmMartin\SyliusSubscriptionPlugin\Form\Type\SubscriptionFrequencyChangeType">
            <argument type="service" id="jpm_martin_sylius_subscription.management.frequency_changer" />
            <tag name="form.type" />
        </service>

        <!-- Both the customer's account and the admin route here; each route says which subscriptions it may reach. -->
        <service id="jpm_martin_sylius_subscription.controller.change_subscription_frequency"
                 class="JpmMartin\SyliusSubscriptionPlugin\Controller\ChangeSubscriptionFrequencyAction"
                 public="true"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription" />
            <argument type="service" id="sylius.context.customer" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.frequency_changer" />
            <argument type="service" id="form.factory" />
            <argument type="service" id="jpm_martin_sylius_subscription.manager.subscription" />
            <argument type="service" id="twig" />
            <argument type="service" id="router" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="jpm_martin_sylius_subscription.controller.retry_subscription_cycle"
                 class="JpmMartin\SyliusSubscriptionPlugin\Controller\RetrySubscriptionCycleAction"
                 public="true"
        >
            <argument type="service" id="jpm_martin_sylius_subscription.repository.subscription_cycle" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.cycle_retrier" />
            <argument type="service" id="jpm_martin_sylius_subscription.manager.subscription_cycle" />
            <argument type="service" id="security.csrf.token_manager" />
            <argument type="service" id="router" />
            <tag name="controller.service_arguments" />
        </service>

        <service id="jpm_martin_sylius_subscription.twig.extension.subscription" class="JpmMartin\SyliusSubscriptionPlugin\Twig\SubscriptionExtension">
            <argument type="service" id="jpm_martin_sylius_subscription.management.frequency_changer" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.cycle_retrier" />
            <argument type="service" id="jpm_martin_sylius_subscription.schedule.scheduler" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.renewal_skipper" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.address_changer" />
            <argument type="service" id="jpm_martin_sylius_subscription.order.renewal_addresses_resolver" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.item_editor" />
            <argument type="service" id="jpm_martin_sylius_subscription.payment.renewal_payment_link_generator" />
            <argument type="service" id="jpm_martin_sylius_subscription.payment.card_update_provider_registry" />
            <argument type="service" id="jpm_martin_sylius_subscription.management.recovery" />
            <tag name="twig.extension" />
        </service>

        <service id="jpm_martin_sylius_subscription.menu.shop_account" class="JpmMartin\SyliusSubscriptionPlugin\Menu\ShopAccountMenuListener">
            <tag name="kernel.event_listener" event="sylius.menu.shop.account" />
        </service>

        <service id="jpm_martin_sylius_subscription.menu.admin_main" class="JpmMartin\SyliusSubscriptionPlugin\Menu\AdminMainMenuListener">
            <tag name="kernel.event_listener" event="sylius.menu.admin.main" />
        </service>
    </services>
</container>
