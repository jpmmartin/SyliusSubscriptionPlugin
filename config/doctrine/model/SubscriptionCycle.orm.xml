<?xml version="1.0" encoding="UTF-8"?>

<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:gedmo="http://gediminasm.org/schemas/orm/doctrine-extensions-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                                      http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd"
>
    <!--
        One renewal. The version column is an optimistic lock: a cycle only advances if nobody else
        advanced it since it was read, which is what stops two runs of the scheduler, or two
        deliveries of the same message, from creating two orders or charging twice.
    -->
    <mapped-superclass name="JpmMartin\SyliusSubscriptionPlugin\Entity\SubscriptionCycle" table="jpm_martin_sylius_subscription_cycle">
        <!-- utf8mb4, as the migrations create it and as Sylius's own tables are. -->
        <options>
            <option name="charset">utf8mb4</option>
            <option name="collation">utf8mb4_unicode_ci</option>
        </options>

        <unique-constraints>
            <!-- A cycle number is taken once per subscription, held by the database. -->
            <unique-constraint name="uniq_jpm_martin_sylius_subscription_cycle_number" columns="subscription_id,number" />
        </unique-constraints>
        <indexes>
            <!-- What the scheduler looks for: cycles due by date, and cycles due for a retry. -->
            <index name="idx_jpm_martin_sylius_subscription_cycle_due" columns="state,scheduled_at" />
            <index name="idx_jpm_martin_sylius_subscription_cycle_next_attempt" columns="state,next_attempt_at" />
        </indexes>

        <id name="id" column="id" type="integer">
            <generator strategy="IDENTITY" />
        </id>

        <field name="number" column="number" type="integer" />
        <field name="scheduledAt" column="scheduled_at" type="datetime_immutable" />
        <field name="state" column="state" type="string" length="24" />
        <field name="holdUntil" column="hold_until" type="datetime_immutable" nullable="true" />
        <field name="renewalNoticeAt" column="renewal_notice_at" type="datetime_immutable" nullable="true" />
        <field name="holdReason" column="hold_reason" type="text" nullable="true" />
        <field name="nextAttemptAt" column="next_attempt_at" type="datetime_immutable" nullable="true" />
        <field name="cancellationReason" column="cancellation_reason" type="text" nullable="true" />
        <field name="version" column="version" type="integer" version="true" />
        <field name="manualRetry" column="manual_retry" type="boolean" />
        <field name="skipped" column="skipped" type="boolean" />

        <field name="createdAt" column="created_at" type="datetime">
            <gedmo:timestampable on="create" />
        </field>
        <field name="updatedAt" column="updated_at" type="datetime" nullable="true">
            <gedmo:timestampable on="update" />
        </field>

        <many-to-one field="subscription" target-entity="JpmMartin\SyliusSubscriptionPlugin\Entity\SubscriptionInterface" inversed-by="cycles">
            <join-column name="subscription_id" referenced-column-name="id" nullable="false" on-delete="CASCADE" />
        </many-to-one>
        <!-- The initial order for cycle 1, the renewal order afterwards. Kept if the order goes. -->
        <many-to-one field="order" target-entity="Sylius\Component\Core\Model\OrderInterface">
            <join-column name="order_id" referenced-column-name="id" nullable="true" on-delete="SET NULL" />
        </many-to-one>

        <!-- Rewritten each time the cycle places an order, as a manual retry does. -->
        <one-to-many field="items" target-entity="JpmMartin\SyliusSubscriptionPlugin\Entity\SubscriptionCycleItemInterface" mapped-by="cycle" orphan-removal="true">
            <cascade>
                <cascade-persist />
            </cascade>
            <order-by>
                <order-by-field name="id" direction="ASC" />
            </order-by>
        </one-to-many>

        <one-to-many field="attempts" target-entity="JpmMartin\SyliusSubscriptionPlugin\Entity\SubscriptionChargeAttemptInterface" mapped-by="cycle">
            <cascade>
                <cascade-persist />
            </cascade>
            <order-by>
                <order-by-field name="attemptedAt" direction="ASC" />
                <order-by-field name="id" direction="ASC" />
            </order-by>
        </one-to-many>
    </mapped-superclass>
</doctrine-mapping>
