<?xml version="1.0" encoding="UTF-8"?>

<constraint-mapping xmlns="http://symfony.com/schema/dic/constraint-mapping"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://symfony.com/schema/dic/constraint-mapping
                                        http://symfony.com/schema/dic/services/constraint-mapping-1.0.xsd"
>
    <class name="JpmMartin\SyliusSubscriptionPlugin\Entity\SubscriptionPlan">
        <constraint name="Symfony\Bridge\Doctrine\Validator\Constraints\UniqueEntity">
            <option name="fields">code</option>
            <option name="message">jpm_martin_sylius_subscription.subscription_plan.code.unique</option>
            <option name="groups">jpm_martin_sylius_subscription</option>
        </constraint>

        <property name="code">
            <constraint name="NotBlank">
                <option name="message">jpm_martin_sylius_subscription.subscription_plan.code.not_blank</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
            <!-- The same shape Sylius accepts for its own codes. -->
            <constraint name="Regex">
                <option name="pattern">/^[\w-]*$/</option>
                <option name="message">jpm_martin_sylius_subscription.subscription_plan.code.regex</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
            <constraint name="Length">
                <option name="max">255</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
        </property>

        <property name="name">
            <constraint name="NotBlank">
                <option name="message">jpm_martin_sylius_subscription.subscription_plan.name.not_blank</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
            <constraint name="Length">
                <option name="max">255</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
        </property>

        <property name="intervalCount">
            <constraint name="GreaterThanOrEqual">
                <option name="value">1</option>
                <option name="message">jpm_martin_sylius_subscription.subscription_plan.interval_count.positive</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
        </property>

        <property name="discountPercentage">
            <constraint name="Range">
                <option name="min">0</option>
                <option name="max">100</option>
                <option name="notInRangeMessage">jpm_martin_sylius_subscription.subscription_plan.discount_percentage.range</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
        </property>

        <property name="maxCycles">
            <constraint name="GreaterThanOrEqual">
                <option name="value">1</option>
                <option name="message">jpm_martin_sylius_subscription.subscription_plan.max_cycles.positive</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
        </property>

        <property name="introductoryDiscountPercentage">
            <constraint name="Range">
                <option name="min">0</option>
                <option name="max">100</option>
                <option name="notInRangeMessage">jpm_martin_sylius_subscription.subscription_plan.introductory_discount_percentage.range</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
        </property>

        <property name="introductoryCycles">
            <constraint name="GreaterThanOrEqual">
                <option name="value">1</option>
                <option name="message">jpm_martin_sylius_subscription.subscription_plan.introductory_cycles.positive</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
        </property>

        <property name="commitmentCycles">
            <constraint name="GreaterThanOrEqual">
                <option name="value">1</option>
                <option name="message">jpm_martin_sylius_subscription.subscription_plan.commitment_cycles.positive</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
            <!-- A commitment longer than the terms last could never be met. -->
            <constraint name="Expression">
                <option name="expression">value === null or this.getMaxCycles() === null or value &lt;= this.getMaxCycles()</option>
                <option name="message">jpm_martin_sylius_subscription.subscription_plan.commitment_cycles.above_max_cycles</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
        </property>

        <property name="trialDays">
            <constraint name="GreaterThanOrEqual">
                <option name="value">1</option>
                <option name="message">jpm_martin_sylius_subscription.subscription_plan.trial_days.positive</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
            <!-- A free trial is one way in, an introductory price another: never both on the same terms. -->
            <constraint name="Expression">
                <option name="expression">value === null or this.getIntroductoryDiscountPercentage() === null</option>
                <option name="message">jpm_martin_sylius_subscription.subscription_plan.trial_days.not_with_introductory_price</option>
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
        </property>

        <property name="productVariant">
            <constraint name="NotNull">
                <option name="groups">jpm_martin_sylius_subscription</option>
            </constraint>
        </property>
    </class>
</constraint-mapping>
