<?xml version="1.0" ?>

<serializer xmlns="http://symfony.com/schema/dic/serializer-mapping"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="http://symfony.com/schema/dic/serializer-mapping https://symfony.com/schema/dic/serializer-mapping/serializer-mapping-1.0.xsd"
>
    <!-- The same names Sylius's AddItemToCart uses, plus the plan. -->
    <class name="JpmMartin\SyliusSubscriptionPlugin\Command\AddSubscriptionItemToCart">
        <attribute name="productVariantCode" serialized-name="productVariant">
            <group>jpm_martin_sylius_subscription:shop:cart:add_subscription_item</group>
        </attribute>
        <attribute name="subscriptionPlanCode" serialized-name="subscriptionPlan">
            <group>jpm_martin_sylius_subscription:shop:cart:add_subscription_item</group>
        </attribute>
        <attribute name="quantity">
            <group>jpm_martin_sylius_subscription:shop:cart:add_subscription_item</group>
        </attribute>
    </class>
</serializer>
