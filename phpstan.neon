# phpstan/extension-installer is not a dependency, so the extensions are included by hand.
includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - vendor/phpstan/phpstan-webmozart-assert/extension.neon

parameters:
    level: max

    # The lowest PHP the plugin supports, so syntax and functions of later versions are reported.
    phpVersion: 80200

    paths:
        - src
